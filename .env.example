# Copy this file to .env and fill in your own values
# ENV controls which environment block is used in config.js (STG or PROD)
ENV=STG

# Staging environment
HOST_STG=https://gorest.co.in/public/v2
TOKEN_STG=your_stg_token_here

# Production environment
HOST_PROD=https://gorest.co.in/public/v2
TOKEN_PROD=your_prod_token_here